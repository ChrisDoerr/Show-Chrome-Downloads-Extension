{
  "manifest_version": 3,
  "name": "Show Chrome Downloads",
  "version": "1.0.0",
  "description": "Opens Chrome Downloads when clicked.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Show Downloads Tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
